{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "source": "trega_functions"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "site": "tregaxmuse",
      "public": "trega_admin/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/.well-known/assetlinks.json",
          "destination": "/assetlinks.json"
        },
        {
          "source": "/l/**",
          "destination": "/l/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "predeploy": [
        "npm --prefix trega_admin run build"
      ],
      "cleanUrls": true
    },
    {
      "site": "trega-listings",
      "public": "trega_listings",
      "ignore": [
        "firebase.json"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/l/**",
          "function": {
            "functionId": "listingPage",
            "region": "asia-south1"
          }
        },
        {
          "source": "/sitemap-listings.xml",
          "function": {
            "functionId": "listingsSitemap",
            "region": "asia-south1"
          }
        },
        {
          "source": "/.well-known/assetlinks.json",
          "destination": "/assetlinks.json"
        }
      ]
    }
  ]
}
