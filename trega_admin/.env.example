# Firebase web config for the Trega admin panel (project: tregaxmuse).
# None of these are secrets — they identify the project. Access is enforced
# by Firestore rules + the `admin` custom claim.
#
# Get them from: Firebase console → Project settings → Your apps → Web app
# (create one if needed) → "SDK setup and configuration" → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tregaxmuse.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tregaxmuse
VITE_FIREBASE_STORAGE_BUCKET=tregaxmuse.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
