rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Set via Cloud Functions / Firebase console custom claims:
      // admin.auth().setCustomUserClaims(uid, {admin: true})
      return signedIn() && request.auth.token.admin == true;
    }

    // ── users/{uid} ──────────────────────────────────────────────
    // Public profiles (seller names on listings). Server-managed fields
    // (role, verifiedSeller, kycStatus) can never be written by clients.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'buyer'
        && request.resource.data.kycStatus == 'unverified'
        && request.resource.data.verifiedSeller == false;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'avatarUrl', 'email', 'settings',
                       'fcmTokens', 'fcmTokenUpdatedAt']);

      // ── users/{uid}/notifications/{notifId} ────────────────────
      // In-app inbox, written server-side by Cloud Functions (bid / order /
      // listing events). Clients may only flip `read`.
      match /notifications/{notifId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ── listings/{listingId} ─────────────────────────────────────
    // Clients create drafts; onListingCreate flips them to live
    // immediately (reactive moderation — the team flags suspicious
    // listings after the fact). Clients never write `status` directly.
    // Only Aadhaar-verified users may sell (verified via BulkPe KYC).
    match /listings/{listingId} {
      allow read: if true; // live listings are public; queries filter status
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'draft'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.kycStatus == 'verified'
        && request.resource.data.keys().hasAll(
             ['sellerId', 'title', 'description', 'categoryId',
              'price', 'condition', 'photos', 'status']);
      allow update: if signedIn() && (
        // Owner editing their own non-live listing (status untouched).
        (resource.data.sellerId == request.auth.uid
          && request.resource.data.status == resource.data.status)
        ||
        // Anyone liking / viewing: only like+view counters may change,
        // and likedBy may only gain/lose the caller's own uid.
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['likedBy', 'likesCount', 'viewCount'])
         && request.resource.data.likedBy.toSet()
              .difference(resource.data.likedBy.toSet())
              .hasOnly([request.auth.uid])
         && resource.data.likedBy.toSet()
              .difference(request.resource.data.likedBy.toSet())
              .hasOnly([request.auth.uid]))
      );
      allow delete: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status != 'sold'; // sold items stay for order records

      // ── listings/{listingId}/private/{docId} ───────────────────
      // Owner-only listing data (pickup address). Never on the public
      // listing doc — readable only by the seller and admins.
      match /private/{docId} {
        function isListingOwner() {
          return signedIn()
            && get(/databases/$(database)/documents/listings/$(listingId))
                 .data.sellerId == request.auth.uid;
        }
        allow read: if isListingOwner() || isAdmin();
        allow create, update: if isListingOwner();
        allow delete: if false;
      }
    }

    // ── bids/{bidId} ─────────────────────────────────────────────
    // Written ONLY by the placeBid/acceptBid callables (Admin SDK bypasses
    // rules). Clients read their own bids; admins can read all bids for
    // the Bids overview page in the admin panel.
    match /bids/{bidId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    // ── orders/{orderId} ─────────────────────────────────────────
    // Created server-side by createCashfreeOrder; paymentStatus updated by
    // the cashfreeWebhook. Clients read their own orders.
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      allow write: if false;
    }

    // ── categories/{categoryId} ─────────────────────────────────
    // Managed from the admin panel by admins (custom claim). Public read.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── kycVerifications/{uid} ───────────────────────────────────
    // Written ONLY by the KYC callables. Users read their own status.
    match /kycVerifications/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── reports/{reportId} ─────────────────────────────────────────
    // User-submitted listing reports (reactive moderation). Doc ID is
    // `{listingId}_{reporterId}` so each user reports a listing at most
    // once. Clients create only; the team reads via the admin panel.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys()
            .hasAll(['listingId', 'reporterId', 'reason']);
      allow update, delete: if false;
    }

    // ── adminNotifications/{id} ─────────────────────────────────
    // Admin panel inbox (separate app, signed in with admin custom claim).
    match /adminNotifications/{notifId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── reviews/{reviewId} ───────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
